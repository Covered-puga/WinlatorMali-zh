    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> 将 DirectX 1-11 调用转换为 OpenGL。<br /><br />
        <i><b>DXVK</b></i> 将 Direct3D 9-11 调用转换为 Vulkan。<br /><br />
        <i><b>VKD3D</b></i> 将 Direct3D 12 API 调用转换为 Vulkan。<br /><br />
        <i><b>CNC DDraw</b></i> 实现了 DirectDraw，以改善经典游戏的兼容性。
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        CALL/RET 指令的标志位处理方式<br /><br />
        <b>0</b>　始终按 CALL/RET 不使用标志位处理（较快，稳定性较差）<br />
        <b>1</b>　大多数 RET 使用标志位，大多数 CALL 不使用<br />
        <b>2</b>　所有 CALL/RET 都使用标志位（较慢）
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">按 x86 的行为生成 -NAN</string>
    <string name="box64_env_var_help__dynarec_fastround">按 x86 的行为精确舍入</string>
    <string name="box64_env_var_help__dynarec_x87double">使用单精度或双精度浮点数模拟 x87</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        动态重编译器构建大型代码块的方式<br /><br />
        <b>0</b>　采用常规大小的代码块<br />
        <b>1</b>　尽可能构建更大的代码块<br />
        <b>2</b>　遇到 ELF 内存中的重叠代码块时继续扩展<br />
        <b>3</b>　遇到任意类型内存中的重叠代码块时继续扩展
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        模拟强内存序<br /><br />
        <b>0</b>　使用默认内存序<br />
        <b>1</b>　部分 MOV 指令写入内存时使用内存屏障<br />
        <b>2</b>　在级别 1 的基础上，为每次 MOV 写入使用内存屏障<br />
        <b>3</b>　在级别 2 的基础上，读取内存及执行部分 SSE/SSE2 指令时也使用内存屏障
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">设置构建代码块时允许向前延伸的最大距离</string>
    <string name="box64_env_var_help__dynarec_callret">优化 CALL/RET 指令</string>
    <string name="box64_env_var_help__dynarec_wait">设置动态重编译器是否等待 FillBlock 完成</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        调整内存屏障，减小模拟强内存序对性能的影响<br /><br />
        <b>0</b>　使用常规的安全屏障<br />
        <b>1</b>　使用弱屏障，小幅提升性能<br />
        <b>2</b>　使用弱屏障，并停用最后一次写入的屏障]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        只生成对齐的原子操作（目前仅适用于 Arm64）。<br /><br />
        <b>0</b>　生成处理未对齐原子操作的代码。<br />
        <b>1</b>　只生成对齐的原子操作，速度更快，生成的代码更小。带 LOCK 前缀的指令访问未对齐的数据地址时会触发 SIGBUS。]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        设置是否延迟计算标志位。<br /><br />
        <b>0</b>　禁用标志位延迟计算。<br />
        <b>1</b>　启用标志位延迟计算。]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        设置是否继续运行未受保护且可能已被修改的代码块。<br /><br />
        <b>0</b>　停止运行这类代码块。<br />
        <b>1</b>　允许动态重编译代码块继续运行，即使它向代码所在的页面写入数据。部分游戏可能加载得更快，也可能意外崩溃。<br />
        <b>2</b>　再将检测到的 HotPage 标记为 NEVERCLEAN。该页不设写保护，但每次都检查从该页构建的代码块。这可能更快，但可能漏检部分自修改代码（SMC）。]]></string>
    <string name="show_adrenotools_unsupported">在不受支持的设备上显示 Adrenotools</string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        设置是否使用宿主 CPU 的标志位。<br /><br />
        <b>0</b>　停用宿主 CPU 的标志位。<br />
        <b>1</b>　在可用时使用宿主 CPU 的标志位。]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        模拟 x86 PAUSE 指令，可能改善自旋锁的性能。<br /><br />
        <b>0</b>　忽略 x86 PAUSE 指令。<br />
        <b>1</b>　使用 YIELD 模拟 x86 PAUSE 指令。<br />
        <b>2</b>　使用 WFI 模拟 x86 PAUSE 指令。<br />
        <b>3</b>　使用 SEVL+WFE 模拟 x86 PAUSE 指令。
    ]]></string>
    <string name="box64_env_var_help__bleeding_edge">启用实验性的动态重编译优化，可能不稳定。</string>
    <string name="box64_env_var_help__jvm">为 Java 虚拟机（JVM）的工作负载优化动态重编译。</string>
    <string name="box64_env_var_help__tcc">集成 TinyCC（TCC）以即时编译部分辅助函数。</string>
    <string name="box64_env_var_help__hotpage">设置动态重编译检测 HotPage 的阈值。</string>
    <string name="box64_env_var_help__fastfcode">为浮点运算生成速度更快、兼容性较低的代码。</string>
    <string name="box64_env_var_help__avx"><![CDATA[
        支持 AVX、AVX2、BMI1、BMI2、ADX、FMA、F16C 和 RDRAND 扩展。<br /><br />
        <b>0</b>　禁用 AVX 扩展。<br />
        <b>1</b>　启用 AVX、BMI1、F16C 和 VAES 扩展。<br />
        <b>2</b>　在级别 1 的基础上启用 AVX2、BMI2、FMA、ADX、VPCLMULQDQ 和 RDRAND。<br />\
    ]]></string>
    <string name="box64_env_var_help__sse42">设置是否模拟 SSE4.2 指令集。</string>
    <string name="box64_env_var_help__sha">设置是否启用 SHA 指令集扩展。</string>
    <string name="box64_env_var_help__futex_waitv">使用 futex_waitv 系统调用改善同步性能（需要 Linux 内核 5.16 或更新版本）。</string>
    <string name="box64_env_var_help__dynarec_gdb">启用 GDB 调试桩，以调试动态重编译生成的代码。</string>
    <string name="box64_env_var_help__dynarec_strongmem_page"><![CDATA[
        按内存页模拟强内存序<br /><br />
        <b>0</b>　禁用<br />
        <b>1</b>　仅对代码页启用<br />
        <b>2</b>　对所有页启用
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Box64 向程序报告的 CPU 数量上限</string>
    <string name="box64_env_var_help__unityplayer">检测 UnityPlayer.dll 并应用强内存序设置</string>
    <string name="box64_env_var_help__mmap32">强制在 32 位地址空间分配内存</string>
    <string name="fexcore_env_var_help__tsoenabled">启用 TSO 中间表示（IR）操作。多线程应用需要此选项。</string>
    <string name="fexcore_env_var_help__core">设置 FEXCore 执行模式。0 使用 JIT（较快），1 使用解释器（较慢，兼容性更好）。</string>
    <string name="fexcore_env_var_help__paranoidtso">启用更严格的 TSO 检查。仅在标准 TSO 无法满足需要时使用。</string>
    <string name="fexcore_env_var_help__smc_symbolic">启用自修改代码（SMC）的符号检查，部分情况下可能更快。</string>
    <string name="fexcore_env_var_help__abi_rewrite">重写 x86 ABI，使其更贴合宿主机的 ARM ABI。</string>
    <string name="fexcore_env_var_help__gdb_port">设置 GDB 远程调试端口，设为 0 可禁用。</string>
    <string name="fexcore_env_var_help__cpu_cores">覆盖向应用报告的 CPU 核心数。</string>
    <string name="fexcore_env_var_help__linux_kernel_version">向客户程序伪报 Linux 内核版本（如 5.15.0）。</string>
    <string name="fexcore_env_var_help__posix_shm">用 POSIX 共享内存替换 SystemV 共享内存。</string>
    <string name="fexcore_env_var_help__mappable_w_x">允许将内存同时映射为可写和可执行（W+X）。</string>
    <string name="fexcore_env_var_help__smc_force_all">强制检查所有内存页上的自修改代码。</string>
    <string name="fexcore_env_var_help__vectortsoenabled">启用 TSO 时，以原子操作执行向量加载和存储。</string>
    <string name="fexcore_env_var_help__halfbarriertsoenabled">启用 TSO 时，对未对齐的加载和存储使用带半屏障的原子操作。</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">启用 TSO 时，以原子操作执行 REP MOVS 和 REP STOS。</string>
    <string name="fexcore_env_var_help__multiblock">启用多块代码编译。可能延长 JIT 编译时间并引起卡顿。</string>
    <string name="fexcore_env_var_help__hostfeatures">控制强制启用或禁用的 CPU 特性。</string>
    <string name="fexcore_env_var_help__smalltscscale">在低频系统上缩放 TSC。</string>
