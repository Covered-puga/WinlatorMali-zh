<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/non_root_performance_boosts"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <!-- Game Mode Signal -->
            <CheckBox
                android:id="@+id/CBDialogGameModeSignal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_game_mode_signal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_game_mode_summary"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp" />

            <!-- Thread Priority Boost -->
            <CheckBox
                android:id="@+id/CBDialogThreadPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_thread_priority_boost"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_thread_priority_summary"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp" />

            <!-- Prefer Big Cores -->
            <CheckBox
                android:id="@+id/CBDialogBigCores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prefer_big_cpu_cores"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_big_cores_summary"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp" />

            <!-- Sustained Performance Mode -->
            <CheckBox
                android:id="@+id/CBDialogSustainedPerf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_sustained_mode"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performance_sustained_summary"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp" />

            <!-- Samsung Galaxy Boost -->
            <LinearLayout
                android:id="@+id/LLDialogSamsungBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/CBDialogSamsungBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/samsung_galaxy_game_turbo"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/performance_samsung_boost_summary"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginStart="32dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
